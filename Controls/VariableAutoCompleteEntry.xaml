<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="PosterFly.Controls.VariableAutoCompleteEntry"
             x:Name="VariableAutoCompleteEntryRoot"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    
    <StackLayout Spacing="0">
        <!-- Main Entry -->
        <Entry x:Name="MainEntry"
               Text="{Binding Text, Source={x:Reference VariableAutoCompleteEntryRoot}}"
               Placeholder="{Binding Placeholder, Source={x:Reference VariableAutoCompleteEntryRoot}}"
               TextChanged="OnTextChanged"
               Focused="OnEntryFocused"
               Unfocused="OnEntryUnfocused"/>
        
        <!-- Auto-complete dropdown -->
        <Border x:Name="AutoCompleteBorder"
                BackgroundColor="White"
                Stroke="LightGray"
                StrokeThickness="1"
                Padding="0"
                IsVisible="False">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="5"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.2" Radius="5" Offset="0,2"/>
            </Border.Shadow>
            
            <CollectionView x:Name="SuggestionsCollectionView"
                            ItemsSource="{Binding Suggestions, Source={x:Reference VariableAutoCompleteEntryRoot}}"
                            MaximumHeightRequest="200">
                
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10,5">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSuggestionTapped"/>
                            </Grid.GestureRecognizers>
                            
                            <StackLayout Orientation="Horizontal" Spacing="10">
                                <Label Text="{Binding Name}" 
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"/>
                                <Label Text="{Binding Value}" 
                                       FontSize="Small"
                                       TextColor="Gray"
                                       VerticalOptions="Center"/>
                                <Label Text="{Binding UsageCount, StringFormat='({0} uses)'}" 
                                       FontSize="Micro"
                                       TextColor="LightGray"
                                       VerticalOptions="Center"/>
                            </StackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>
        
        <!-- Variable insertion hint -->
        <Label x:Name="HintLabel"
               Text="Type {{ to see available variables"
               FontSize="Micro"
               TextColor="Gray"
               IsVisible="False"
               Margin="5,2,0,0"/>
    </StackLayout>
    
</ContentView>