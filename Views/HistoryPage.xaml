<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="PosterFly.Views.HistoryPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="History">
    
    <StackLayout Padding="20" Spacing="15">
        
        <!-- Header -->
        <StackLayout Orientation="Horizontal">
            <Label Text="Recent Requests" 
                   FontSize="Large" 
                   FontAttributes="Bold" 
                   VerticalOptions="Center" 
                   HorizontalOptions="StartAndExpand"/>
            <Button Text="Clear All" 
                    Command="{Binding ClearHistoryCommand}"
                    BackgroundColor="Red" 
                    TextColor="White"/>
        </StackLayout>

        <!-- History List -->
        <CollectionView ItemsSource="{Binding RecentRequests}" x:Name="HistoryListView">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="White" Padding="15" Margin="0,5" CornerRadius="8" HasShadow="True">
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto">
                            
                            <!-- Method Badge -->
                            <Frame Grid.Row="0" Grid.Column="0" 
                                   BackgroundColor="{Binding Method, Converter={StaticResource HttpMethodToColorConverter}}"
                                   Padding="8,4" CornerRadius="12" HasShadow="False" Margin="0,0,10,0">
                                <Label Text="{Binding Method}" 
                                       TextColor="White" 
                                       FontSize="Small" 
                                       FontAttributes="Bold"/>
                            </Frame>
                            
                            <!-- Request Info -->
                            <StackLayout Grid.Row="0" Grid.Column="1" Spacing="5">
                                <Label Text="{Binding Name}" 
                                       FontSize="Medium" 
                                       FontAttributes="Bold"/>
                                <Label Text="{Binding Url}" 
                                       FontSize="Small" 
                                       TextColor="Gray"
                                       LineBreakMode="TailTruncation"/>
                            </StackLayout>
                            
                            <!-- Actions -->
                            <Button Grid.Row="0" Grid.Column="2" 
                                    Text="⋯"
                                    BackgroundColor="LightGray"
                                    TextColor="Black"
                                    WidthRequest="35"
                                    HeightRequest="35"
                                    CornerRadius="17"/>
                            
                            <!-- Request Type and Time -->
                            <StackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" 
                                         Orientation="Horizontal" Spacing="15" Margin="0,10,0,0">
                                <Frame BackgroundColor="{Binding Type, Converter={StaticResource RequestTypeToColorConverter}}"
                                       Padding="6,3" CornerRadius="8" HasShadow="False">
                                    <Label Text="{Binding Type}" 
                                           TextColor="White" 
                                           FontSize="Micro"/>
                                </Frame>
                                <Label Text="{Binding CreatedAt, StringFormat='{0:MMM dd, HH:mm}'}" 
                                       FontSize="Small" 
                                       TextColor="Gray"
                                       VerticalOptions="Center"/>
                                <Label Text="{Binding UseSSL, StringFormat='SSL: {0}'}" 
                                       FontSize="Small" 
                                       TextColor="Gray"
                                       VerticalOptions="Center"/>
                                <Label Text="{Binding UseHttp2, StringFormat='HTTP/2: {0}'}" 
                                       FontSize="Small" 
                                       TextColor="Gray"
                                       VerticalOptions="Center"/>
                            </StackLayout>
                            
                            <!-- Action Buttons -->
                            <StackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                         Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                                <Button Text="Use Again" 
                                        Command="{Binding Source={x:Reference HistoryListView}, Path=BindingContext.ReuseRequestCommand}"
                                        CommandParameter="{Binding}"
                                        BackgroundColor="Green" 
                                        TextColor="White"
                                        FontSize="Small"/>
                                <Button Text="Save" 
                                        Command="{Binding Source={x:Reference HistoryListView}, Path=BindingContext.SaveFromHistoryCommand}"
                                        CommandParameter="{Binding}"
                                        BackgroundColor="Orange" 
                                        TextColor="White"
                                        FontSize="Small"/>
                                <Button Text="Delete" 
                                        Command="{Binding Source={x:Reference HistoryListView}, Path=BindingContext.DeleteFromHistoryCommand}"
                                        CommandParameter="{Binding}"
                                        BackgroundColor="Red" 
                                        TextColor="White"
                                        FontSize="Small"/>
                            </StackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        
        <!-- Empty State -->
        <StackLayout IsVisible="{Binding HasNoHistory}" VerticalOptions="CenterAndExpand">
            <Label Text="No request history" 
                   FontSize="Large" 
                   HorizontalOptions="Center" 
                   TextColor="Gray"/>
            <Label Text="Your recent API requests will appear here" 
                   FontSize="Medium" 
                   HorizontalOptions="Center" 
                   TextColor="Gray"
                   Margin="20"/>
        </StackLayout>
        
    </StackLayout>
    
</ContentPage>