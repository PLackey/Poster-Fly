<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PosterFly.MainPage"
             Title="Poster Fly">

    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="25">
            
            <Image Source="posterfly_logo.png"
                   HeightRequest="200"
                   Aspect="AspectFit" />

            <Label Text="Welcome to Poster Fly!"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="A powerful cross-platform API testing tool"
                   FontSize="18"
                   HorizontalOptions="Center"
                   TextColor="Gray" />

            <Button x:Name="StartBtn"
                    Text="Get Started" 
                    Clicked="OnStartClicked"
                    BackgroundColor="Blue"
                    TextColor="White"
                    FontSize="18"
                    HorizontalOptions="Center"
                    WidthRequest="200" />
                    
            <StackLayout Spacing="10" Margin="0,30,0,0">
                <Label Text="Features:" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                <Label Text="• HTTP/REST API Testing" FontSize="16" HorizontalOptions="Center"/>
                <Label Text="• GraphQL Support" FontSize="16" HorizontalOptions="Center"/>
                <Label Text="• gRPC Integration" FontSize="16" HorizontalOptions="Center"/>
                <Label Text="• Variable Management" FontSize="16" HorizontalOptions="Center"/>
                <Label Text="• Collection Organization" FontSize="16" HorizontalOptions="Center"/>
                <Label Text="• Cross-platform Support" FontSize="16" HorizontalOptions="Center"/>
            </StackLayout>
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
